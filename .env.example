# =============================================================================
# .env.example — copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# .env is listed in .gitignore and .dockerignore so it is NEVER committed
# or baked into the Docker image. Keep your tokens here, not in code.
# =============================================================================

# ---------------------------------------------------------------------------
# Hugging Face Hub — checkpoint upload
# Leave blank to run fully offline (checkpoints are saved locally only).
# ---------------------------------------------------------------------------

# Your HF Hub model repo, e.g. "your-username/anymal-d-ppo"
HF_MODEL_REPO=

# Your HF write token (generate at https://huggingface.co/settings/tokens)
# Alternatively, run `huggingface-cli login` and leave this blank.
HF_TOKEN=

# 1 = create the repo as private (default), 0 = public
HF_PRIVATE=1

# ---------------------------------------------------------------------------
# Trackio dashboard on a Hugging Face Space
# Leave blank to use the local dashboard only (`trackio show --project ...`).
# ---------------------------------------------------------------------------
TRACKIO_SPACE_ID=
